{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "/takizawa_schedule/**",
        "headers": [{ "key": "Cache-Control", "value": "no-store" }]
      },
      {
        "source": "/helpers/**",
        "headers": [{ "key": "Cache-Control", "value": "no-store" }]
      },
      {
        "source": "/service-records/**",
        "headers": [{ "key": "Cache-Control", "value": "no-store" }]
      },
      {
        "source": "/service-records-test/**",
        "headers": [{ "key": "Cache-Control", "value": "no-store" }]
      },
      {
        "source": "/service-records-home/**",
        "headers": [{ "key": "Cache-Control", "value": "no-store" }]
      },
      {
        "source": "/helper-shift/**",
        "headers": [{ "key": "Cache-Control", "value": "no-store" }]
      },
      {
        "source": "/**/*.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/**/*.css",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ],
    "rewrites": [
      {
        "source": "/api/home-schedule-tasks/pending",
        "function": { "functionId": "getHomeScheduleTasksPending", "region": "asia-northeast1" }
      },
      {
        "source": "/api/home-service-check-items",
        "function": { "functionId": "getHomeServiceCheckItems", "region": "asia-northeast1" }
      },
      {
        "source": "/api/home-service-records/latest",
        "function": { "functionId": "getHomeServiceRecordLatest", "region": "asia-northeast1" }
      },
      {
        "source": "/api/home-service-records",
        "function": { "functionId": "postHomeServiceRecord", "region": "asia-northeast1" }
      },
      {
        "source": "/api/training",
        "function": { "functionId": "trainingProxy", "region": "asia-northeast1" }
      },
      {
        "source": "/api/training-report",
        "run": { "serviceId": "training-service", "region": "asia-northeast1" }
      },

      {
        "source": "/takizawa_schedule/**",
        "destination": "/takizawa_schedule/index.html"
      },
      { "source": "/helpers/**", "destination": "/helpers/index.html" },

      {
        "source": "/service-records-admin/**",
        "destination": "/service-records-admin/index.html"
      },
      {
        "source": "/service-records/**",
        "destination": "/service-records/index.html"
      },

      {
        "source": "/service-records-test/**",
        "destination": "/service-records-test/index.html"
      },
      {
        "source": "/service-records-home/**",
        "destination": "/service-records-home/index.html"
      },
      {
        "source": "/service-records-top/**",
        "destination": "/service-records-top/index.html"
      },

      {
        "source": "/helper-shift/**",
        "destination": "/helper-shift/index.html"
      },
      { "source": "/tamari/**", "destination": "/tamari/index.html" },

      { "source": "**", "destination": "/index.html" }
    ]
  }
}